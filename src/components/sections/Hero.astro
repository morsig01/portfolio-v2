---
import { Book, Contact, FolderOpen, GitBranch } from '@lucide/astro';
import Card from '../ui/Card.astro';
---
<div class="h-screen w-auto bg-blue-700 flex items-center justify-evenly flex-row">
    <h1 class="text-[10rem] font-bold">Morgan</h1>
    <div class="flex flex-col gap-4">
        <div class="flex flex-row gap-4">
            <Card icon={FolderOpen} label="Projects" href="/projects" />
            <Card icon={Book} label="About" href="/about" />
        </div>
        <div class="flex flex-row gap-4">
            <Card icon={GitBranch} label="GitHub" href="https://github.com/morsig01" external />
            <Card icon={Contact} label="LinkedIn" href="https://linkedin.com/in/morgan-sigland-b2993134b/" external />
        </div>
    </div>
</div>

