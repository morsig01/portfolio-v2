---
interface Props {
	icon: any;
	label: string;
	href: string;
	external?: boolean;
}

const { icon: Icon, label, href, external = false } = Astro.props;
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="group"
  >
  <div class="aspect-square w-64 border border-(--border-subtle) bg-(--bg-surface) rounded-lg flex flex-col items-center justify-center">
    <Icon size={48} class="translate-y-4 transition-transform duration-300 group-hover:translate-y-0" />
    <span class="text-xl font-semibold opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">{label}</span>
  </div>
</a>